# apply.py 실행용. 이 파일을 .env 로 복사해 채운다 (.env 는 gitignore 대상, 절대 커밋하지 말 것)
#   cp monitoring/datadog/.env.example monitoring/datadog/.env
#   set -a; source monitoring/datadog/.env; set +a
#   python3 monitoring/datadog/apply.py

DD_SITE=us5.datadoghq.com
DD_API_KEY=
# Organization Settings > Application Keys 에서 발급
DD_APP_KEY=

# Discord 채널 설정 > 연동 > 웹후크 URL
DISCORD_WEBHOOK_URL=

# Synthetics (외부에서 접근 가능한 주소와 전용 계정)
ZUKBAM_BASE_URL=http://<공인 IP>:8080
ZUKBAM_SYNTH_EMAIL=
ZUKBAM_SYNTH_PASSWORD=

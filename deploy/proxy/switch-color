#!/bin/sh
# 요청을 받을 색을 바꾼다. 사용법: switch-color blue|green
# reload는 처리 중인 요청을 끊지 않는다. 기존 worker가 받던 요청을 끝낸 뒤 내려가고, 새 요청은 새 색으로 간다
set -e

color="$1"
case "$color" in
    blue|green) ;;
    *) echo "사용법: switch-color blue|green" >&2; exit 1 ;;
esac

state=/etc/nginx/state/active.conf
cp "$state" "$state.bak"
echo "set \$backend_host backend-$color;" > "$state"

if ! nginx -t 2>/dev/null; then
    mv "$state.bak" "$state"
    echo "nginx 설정 검사에 실패해 이전 색으로 되돌렸습니다" >&2
    exit 1
fi

rm -f "$state.bak"
nginx -s reload
